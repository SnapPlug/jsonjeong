# Secrets fed into Kamal at deploy time. Safe-for-git — no raw credentials here.
# Values resolve from ENV or commands at runtime.
#
# Required:
#   - RAILS_MASTER_KEY        — used to decrypt config/credentials.yml.enc
#   - KAMAL_REGISTRY_PASSWORD — GitHub PAT with write:packages scope (push image to ghcr.io)
#   - CERTIFICATE_PEM         — Cloudflare Origin Certificate (PEM)
#   - PRIVATE_KEY_PEM         — Cloudflare Origin Private Key (PEM)
#
# Cert/key files live outside the repo at ~/.config/jsonjeong-cert/.

RAILS_MASTER_KEY=$(cat config/master.key)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
CERTIFICATE_PEM=$(cat ~/.config/jsonjeong-cert/origin.crt)
PRIVATE_KEY_PEM=$(cat ~/.config/jsonjeong-cert/origin.key)

# ops(관제) — 값은 ~/.config/overload/ 파일에서 읽는다
VERCEL_TOKEN=$(cat ~/.config/overload/vercel_token)
TELEGRAM_BOT_TOKEN=$(cat ~/.config/overload/telegram_bot_token)
TELEGRAM_CHAT_ID=$(cat ~/.config/overload/telegram_chat_id)
TELEGRAM_ADMIN_CHAT_ID=$(cat ~/.config/overload/telegram_admin_chat_id)   # 봇 명령을 받는 Jason 개인 대화
TELEGRAM_WEBHOOK_SECRET=$(cat ~/.config/overload/telegram_webhook_secret)   # setWebhook secret_token과 같은 값
HEALTHCHECKS_URL=$(cat ~/.config/overload/healthchecks_url)
OPS_PASSWORD=$(cat ~/.config/overload/ops_password)   # 관제 로그인 비밀번호. Jason이 파일에 직접 쓴다

# 주간 보안 점검(SecurityAudit) — 서버 상태 전용 SSH 키(강제 명령이라 상태만 읽힌다)와 Supabase 관리 토큰
OPS_AUDIT_SSH_KEY=$(xxd -p ~/.config/overload/ops_audit_ssh_key | tr -d '\n')   # 16진수: base64는 kamal 비밀값 읽기에서 글자가 빠졌다
SUPABASE_ACCESS_TOKEN=$(cat ~/.config/overload/supabase_token)
