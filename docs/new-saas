        orderName: this.orderNameValue, totalAmount: this.amountValue,
        currency: "CURRENCY_KRW", redirectUrl: this.redirectUrlValue,
      })
      if (response?.code) { alert(response.message); btn.disabled = false; btn.textContent = "다시 결제하기" }
    } catch { alert("결제 중 오류가 발생했습니다."); btn.disabled = false; btn.textContent = "다시 결제하기" }
  }
}
