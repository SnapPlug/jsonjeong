<%= render "ideas/head", title: t("submit.title"), description: t("submit.description") %>

<div class="mx-auto max-w-xl px-[14px] py-8 min-[700px]:py-12">
  <%= link_to t("archive.back"), root_path, class: "text-sm font-semibold text-brand-dark underline underline-offset-4 decoration-2 decoration-brand" %>
  <h1 class="mt-4 text-2xl font-extrabold tracking-tight min-[700px]:text-3xl"><%= t("submit.title") %></h1>
  <p class="mt-2 text-[15px] leading-relaxed text-ink/90"><%= t("submit.lead") %></p>
  <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
    <% t("submit.rules").each do |rule| %><li><%= rule %></li><% end %>
  </ul>

  <%= form_with model: @submission, url: submissions_path, class: "mt-8 space-y-5" do |f| %>
    <% if @submission.errors.any? %>
      <div class="rounded-lg border border-red-300 bg-red-50 p-3 text-sm text-red-800">
        <ul class="list-disc pl-5"><% @submission.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul>
      </div>
    <% end %>

    <%# 봇 덫: 사람에게는 보이지 않는다 %>
    <div class="hidden" aria-hidden="true"><%= text_field_tag :website, nil, tabindex: -1, autocomplete: "off" %></div>

    <% field = "block w-full rounded-lg border border-black/15 bg-white px-3 py-2 text-[15px] focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand/40" %>
    <% label = "block text-sm font-semibold" %>
    <% hint = "mt-1 text-xs text-muted" %>

    <div>
      <%= f.label :name, t("submit.f.name"), class: label %>
      <%= f.text_field :name, class: field, required: true, maxlength: 80, placeholder: t("submit.ph.name") %>
    </div>
    <div>
      <%= f.label :url, t("submit.f.url"), class: label %>
      <%= f.url_field :url, class: field, placeholder: "https://", pattern: "https://.*" %>
      <p class="<%= hint %>"><%= t("submit.h.url") %></p>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= f.label :started_on, t("submit.f.started_on"), class: label %>
        <%= f.date_field :started_on, class: field, required: true %>
      </div>
      <div>
        <%= f.label :ended_on, t("submit.f.ended_on"), class: label %>
        <%= f.date_field :ended_on, class: field %>
        <p class="<%= hint %>"><%= t("submit.h.ended_on") %></p>
      </div>
    </div>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <%= f.label :hours, t("submit.f.hours"), class: label %>
        <%= f.number_field :hours, class: field, required: true, min: 0, step: 0.5, inputmode: "decimal" %>
      </div>
      <div>
        <%= f.label :cost_usd, t("submit.f.cost_usd"), class: label %>
        <%= f.number_field :cost_usd, class: field, required: true, min: 0, step: 1, inputmode: "decimal" %>
      </div>
      <div>
        <%= f.label :revenue_usd, t("submit.f.revenue_usd"), class: label %>
        <%= f.number_field :revenue_usd, class: field, required: true, min: 0, step: 1, inputmode: "decimal" %>
      </div>
    </div>
    <p class="-mt-3 text-xs text-muted"><%= t("submit.h.money") %></p>

    <div>
      <%= f.label :stuck, t("submit.f.stuck"), class: label %>
      <%= f.text_area :stuck, class: field, rows: 2, required: true, maxlength: 300, placeholder: t("submit.ph.stuck") %>
    </div>
    <div>
      <%= f.label :quit_signal, t("submit.f.quit_signal"), class: label %>
      <%= f.text_area :quit_signal, class: field, rows: 2, required: true, maxlength: 300, placeholder: t("submit.ph.quit_signal") %>
      <p class="<%= hint %>"><%= t("submit.h.quit_signal") %></p>
    </div>
    <div>
      <%= f.label :tools, t("submit.f.tools"), class: label %>
      <%= f.text_field :tools, class: field, maxlength: 120, placeholder: t("submit.ph.tools") %>
    </div>
    <div>
      <%= f.label :proof_url, t("submit.f.proof_url"), class: label %>
      <%= f.url_field :proof_url, class: field, placeholder: "https://", pattern: "https://.*" %>
      <p class="<%= hint %>"><%= t("submit.h.proof_url") %></p>
    </div>
    <div>
      <%= f.label :email, t("submit.f.email"), class: label %>
      <%= f.email_field :email, class: field, required: true, autocomplete: "email" %>
      <p class="<%= hint %>"><%= t("submit.h.email") %></p>
    </div>

    <%= f.submit t("submit.button"), class: "w-full rounded-lg bg-brand-dark px-4 py-3 text-base font-bold text-white hover:opacity-90 cursor-pointer" %>
  <% end %>
</div>
