<%
  status_class = {
    "active" => "bg-brand/15 text-brand-dark",
    "pivoted" => "bg-brand/15 text-brand-dark",
    "released" => "bg-brand-dark text-white"
  }.fetch(idea.status, "bg-black/5 text-ink/60")
  has_retro = idea.retro?
  period = [ idea.started_on.strftime("%Y-%m-%d"), idea.ongoing? ? t("archive.ongoing") : idea.ended_on.strftime("%Y-%m-%d") ].join(" → ")
%>

<article class="bg-surface rounded-2xl p-6 flex flex-col gap-3">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-base font-bold text-ink"><%= idea.title %></h3>
    <span class="shrink-0 rounded-full <%= status_class %> text-xs font-semibold px-2 py-0.5"><%= t("archive.status.#{idea.status}") %></span>
  </div>

  <p class="text-[15px] text-ink/90 leading-relaxed"><%= idea.summary %></p>

  <dl class="grid grid-cols-3 gap-2 rounded-xl bg-page px-3 py-3 text-center">
    <div>
      <dt class="text-xs text-muted"><%= t("archive.hours") %></dt>
      <dd class="mt-0.5 font-mono text-lg font-bold text-ink"><%= work_hours(idea.hours) %></dd>
    </div>
    <div>
      <dt class="text-xs text-muted"><%= t("archive.cost") %></dt>
      <dd class="mt-0.5 font-mono text-lg font-bold text-ink"><%= usd(idea.cost_usd) %></dd>
    </div>
    <div>
      <dt class="text-xs text-muted"><%= t("archive.revenue") %></dt>
      <dd class="mt-0.5 font-mono text-lg font-bold text-ink"><%= usd(idea.revenue_usd) %></dd>
    </div>
  </dl>

  <p class="font-mono text-xs text-muted"><%= period %> · <%= t("archive.hours_source.#{idea.hours_source}") %></p>

  <% if idea.stuck.present? || idea.human.present? %>
    <dl class="flex flex-col gap-1.5 text-sm leading-relaxed">
      <% if idea.stuck.present? %>
        <div><dt class="inline font-semibold text-ink"><%= t("archive.stuck") %></dt> <dd class="inline text-ink/80"><%= idea.stuck %></dd></div>
      <% end %>
      <% if idea.human.present? %>
        <div><dt class="inline font-semibold text-ink"><%= t("archive.human") %></dt> <dd class="inline text-ink/80"><%= idea.human %></dd></div>
      <% end %>
    </dl>
  <% end %>

  <% if has_retro || idea.url %>
    <div class="mt-auto pt-3 border-t border-black/[0.06] flex flex-wrap items-center gap-x-4 gap-y-2 text-sm font-semibold">
      <% if has_retro %>
        <%= link_to t("archive.retro"), idea_path(idea.slug), class: "text-brand-dark underline underline-offset-4 decoration-2 decoration-brand hover:opacity-80" %>
      <% end %>
      <% if idea.url %>
        <%# url은 config/ideas.yml 값이고 https만 들어온다(IdeaTest가 막는다). %>
        <a href="<%= idea.url %>" target="_blank" rel="noopener" class="text-muted hover:text-ink"><%= t("archive.visit") %></a>
      <% end %>
    </div>
  <% end %>
</article>
