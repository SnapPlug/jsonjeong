<%# nomads.com 카드(크기·간격·모서리 동일): 사진 위에 숫자 몇 개만. 마우스를 올리거나(데스크톱) 포커스하면(휴대폰) 막대 그래프가 덮인다. %>
<%
  max = Idea.maxima
  # 많이 쓸수록 주의·심각. 번 돈은 하루 목표 $100 기준.
  spend_tone = ->(r) { r < 0.34 ? :good : (r < 0.67 ? :warning : :critical) }
  bars = [
    [ "⏱", t("archive.hours"), idea.hours / max[:hours], work_hours(idea.hours) ],
    [ "📅", t("archive.days"), idea.days.to_f / max[:days], t("archive.days_unit", days: idea.days) ],
    [ "💸", t("archive.cost"), max[:cost_usd].zero? ? 0 : idea.cost_usd / max[:cost_usd], usd(idea.cost_usd) ]
  ].map { |emoji, label, ratio, value| [ emoji, label, ratio, value, spend_tone.(ratio) ] }
  earned = idea.revenue_usd / 100.0
  bars << [ "💰", t("archive.revenue"), earned, usd(idea.revenue_usd), earned >= 1 ? :good : :warning ]
%>
<%= link_to idea_path(idea.slug), class: "group relative block overflow-hidden rounded-xl bg-brand-dark text-white shadow-[0_0_0_1px_#ddd] outline-none focus-visible:ring-4 focus-visible:ring-brand #{Idea::CARD_HEIGHT}" do %>
  <%= idea_image idea, loading: "lazy", decoding: "async", class: "absolute inset-0 h-full w-full object-cover" %>
  <div class="absolute inset-0 bg-black/30"></div>

  <div class="absolute inset-0 transition-opacity duration-200 group-hover:opacity-0 group-focus-visible:opacity-0 [text-shadow:0_1px_4px_rgb(0_0_0/0.75)]">
    <span class="absolute left-[14px] top-[14px] border-b-2 border-white pb-0.5 text-base font-bold min-[700px]:text-lg"><%= number %></span>
    <%# 휴대폰 2열에선 한 줄(3.6시간), 넓으면 nomads처럼 숫자 아래 단위 %>
    <span class="absolute right-[14px] top-[14px] text-right leading-none">
      <span class="text-base font-bold min-[700px]:block min-[700px]:text-xl"><%= number_with_precision(idea.hours, precision: 1, strip_insignificant_zeros: true) %></span><span class="text-[11px] font-semibold min-[700px]:mt-0.5 min-[700px]:block"><%= t("archive.hours_short") %></span>
    </span>

    <%# 위아래 모서리 숫자를 피한 가운데 띠. 휴대폰 2열에선 글자를 줄이고 3줄까지만. %>
    <div class="absolute inset-x-0 inset-y-[36px] flex flex-col items-center justify-center px-2.5 text-center min-[700px]:inset-y-[56px] min-[700px]:px-4">
      <h3 class="line-clamp-3 text-[15px] font-bold leading-tight min-[700px]:text-[26px]"><%= idea.title %></h3>
      <p class="mt-1 hidden min-[700px]:block min-[700px]:text-base"><%= t("archive.status.#{idea.status}") %></p>
    </div>

    <span class="absolute bottom-[14px] left-[14px] leading-none">
      <span class="block text-sm font-bold min-[700px]:text-base"><%= usd(idea.cost_usd) %></span>
      <span class="mt-0.5 block text-[10px] font-bold uppercase"><%= t("archive.spent_label") %></span>
    </span>
    <span class="absolute bottom-[14px] right-[14px] text-right leading-none">
      <span class="block text-base font-bold min-[700px]:text-xl"><%= usd(idea.revenue_usd) %></span>
      <span class="mt-0.5 block text-[10px] font-bold uppercase"><%= t("archive.earned_label") %></span>
    </span>
  </div>

  <div class="absolute inset-0 flex flex-col justify-center gap-2.5 bg-black/70 px-[14px] opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100 min-[700px]:gap-3 min-[700px]:px-5">
    <% bars.each do |emoji, label, ratio, value, tone| %>
      <%= render "bar", emoji:, label:, ratio:, value:, tone: %>
    <% end %>
  </div>
<% end %>
