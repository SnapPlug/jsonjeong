<% content_for :title, title %>
<% content_for :description, description %>
<% content_for :head do %>
  <link rel="alternate" hreflang="ko" href="<%= site_url %><%= alternate_path(:ko) %>">
  <link rel="alternate" hreflang="en" href="<%= site_url %><%= alternate_path(:en) %>">
  <link rel="alternate" hreflang="x-default" href="<%= site_url %><%= alternate_path(:ko) %>">
<% end %>
