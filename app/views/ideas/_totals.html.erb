<%# 오른쪽 위 통계 카드. 합계 숫자 + 상태별 개수 막대(한 계열이라 한 색, 범례 없음, 값 글자 옆에). 휴대폰(2열)에선 두 칸 전체. %>
<% counts = Idea.status_counts %>
<section class="col-span-2 flex flex-col rounded-xl bg-surface p-[14px] text-ink shadow-[0_0_0_1px_#ddd] min-[700px]:col-span-1 min-[700px]:row-start-1 min-[700px]:col-start-3 min-[700px]:p-4 min-[1000px]:col-start-4 min-[1500px]:col-start-5 min-[700px]:min-h-[calc(33vw-56px)] min-[1000px]:min-h-[calc(25vw-56px)] min-[1300px]:min-h-[284px]" aria-label="<%= t("archive.title") %>">
  <dl class="grid grid-cols-4 gap-2 border-b border-black/10 pb-2.5 min-[700px]:grid-cols-2 min-[700px]:gap-y-1.5">
    <% [ [ t("archive.ideas_label"), totals[:count] ], [ t("archive.hours"), work_hours(totals[:hours]) ],
         [ t("archive.cost"), usd(totals[:cost_usd]) ], [ t("archive.revenue"), usd(totals[:revenue_usd]) ] ].each do |label, value| %>
      <div>
        <dt class="text-[11px] text-muted"><%= label %></dt>
        <dd class="text-base font-extrabold leading-tight min-[1300px]:text-lg"><%= value %></dd>
      </div>
    <% end %>
  </dl>

  <h2 class="mt-2 text-xs font-semibold text-muted"><%= t("archive.by_status") %></h2>
  <ul class="mt-1.5 flex flex-col gap-[3px]">
    <% top = counts.values.max %>
    <% counts.each do |status, n| %>
      <li class="grid grid-cols-[4.75rem_1fr_1.25rem] items-center gap-2 text-[13px]" title="<%= t("archive.status.#{status}") %>: <%= n %>">
        <span><%= render "status_badge", status:, size: :sm %></span>
        <span class="h-2.5 rounded-full bg-black/[0.06]"><span class="block h-full rounded-full bg-brand-dark" style="width: <%= (n * 100.0 / top).round(1) %>%"></span></span>
        <span class="text-right font-bold tabular-nums"><%= n %></span>
      </li>
    <% end %>
  </ul>
</section>
