<%# 오른쪽 위 고정 카드 — 전체 합계 %>
<section class="flex aspect-auto flex-col rounded-2xl bg-surface p-5 shadow-sm sm:aspect-[9/8] sm:col-start-2 sm:row-start-1 lg:col-start-3 xl:col-start-4" aria-label="<%= t("archive.title") %>">
  <h2 class="text-lg font-extrabold text-ink"><%= t("archive.title") %></h2>
  <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-3">
    <% [
         [ t("archive.ideas_label"), totals[:count] ],
         [ t("archive.hours"), work_hours(totals[:hours]) ],
         [ t("archive.cost"), usd(totals[:cost_usd]) ],
         [ t("archive.revenue"), usd(totals[:revenue_usd]) ]
       ].each do |label, value| %>
      <div>
        <dt class="text-xs text-muted"><%= label %></dt>
        <dd class="font-mono text-2xl font-bold text-ink"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-auto pt-3 text-xs leading-relaxed text-muted"><%= t("archive.hours_note") %></p>
</section>
