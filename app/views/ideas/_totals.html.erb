<%# 오른쪽 위 고정 카드 — 전체 합계 %>
<%# 휴대폰(2열)에선 두 칸을 다 쓰고, 그보다 넓으면 첫 줄 마지막 칸 — nomads.com 오른쪽 칸 자리 %>
<section class="col-span-2 flex flex-col rounded-xl bg-surface p-[14px] shadow-[0_0_0_1px_#ddd] min-[700px]:col-span-1 min-[700px]:row-start-1 min-[700px]:col-start-3 min-[700px]:p-5 min-[1000px]:col-start-4 min-[1500px]:col-start-5 min-[700px]:min-h-[calc(33vw-56px)] min-[1000px]:min-h-[calc(25vw-56px)] min-[1300px]:min-h-[284px]" aria-label="<%= t("archive.title") %>">
  <h2 class="text-lg font-extrabold text-ink"><%= t("archive.title") %></h2>
  <dl class="mt-3 grid grid-cols-4 gap-x-3 gap-y-3 min-[700px]:grid-cols-2">
    <% [
         [ t("archive.ideas_label"), totals[:count] ],
         [ t("archive.hours"), work_hours(totals[:hours]) ],
         [ t("archive.cost"), usd(totals[:cost_usd]) ],
         [ t("archive.revenue"), usd(totals[:revenue_usd]) ]
       ].each do |label, value| %>
      <div>
        <dt class="text-xs text-muted"><%= label %></dt>
        <dd class="font-mono text-lg font-bold text-ink min-[1300px]:text-2xl"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-auto pt-3 text-[11px] leading-relaxed text-muted"><%= t("archive.hours_note") %></p>
</section>
