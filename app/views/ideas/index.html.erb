<%= render "head", title: t("archive.title"), description: t("archive.description") %>

<%# 바깥 여백·간격은 nomads.com과 같다: 화면 끝에서 카드까지 50px(휴대폰 14px), 카드 사이 28px(휴대폰 14px) %>
<div class="px-[14px] py-[14px] min-[700px]:px-[50px] min-[700px]:py-7">
  <h1 class="sr-only"><%= t("archive.title") %></h1>
  <div class="grid grid-cols-2 gap-[14px] min-[700px]:grid-cols-3 min-[700px]:gap-7 min-[1000px]:grid-cols-4 min-[1500px]:grid-cols-5">
    <%= render "totals", totals: @totals %>
    <%= render "profile" %>
    <% @ideas.each_with_index do |idea, i| %>
      <%= render "card", idea:, number: i + 1 %>
    <% end %>
  </div>

  <p class="mt-6 text-xs text-muted"><%= t("archive.hours_note") %></p>
</div>

<% content_for :head do %>
  <script type="application/ld+json"><%= raw ideas_structured_data(@ideas).to_json %></script>
<% end %>
