<%= render "head", title: t("archive.title"), description: t("archive.description") %>

<div class="mx-auto max-w-[1600px] px-4 py-8 sm:px-6 lg:px-10 lg:py-12">
  <%= render "profile" %>

  <div class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    <%= render "totals", totals: @totals %>
    <%= render partial: "card", collection: @ideas, as: :idea %>
  </div>
</div>

<% content_for :head do %>
  <script type="application/ld+json"><%= raw ideas_structured_data(@ideas).to_json %></script>
<% end %>
