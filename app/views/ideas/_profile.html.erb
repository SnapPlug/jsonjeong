<%# 오른쪽 끝 둘째 줄 — 소개·언어·링크 카드. 휴대폰(2열)에선 두 칸 전체. %>
<section class="col-span-2 flex flex-col rounded-xl bg-surface p-[14px] text-ink shadow-[0_0_0_1px_#ddd] min-[700px]:col-span-1 min-[700px]:row-start-2 min-[700px]:col-start-3 min-[700px]:p-5 min-[1000px]:col-start-4 min-[1500px]:col-start-5 min-[700px]:min-h-[calc(33vw-56px)] min-[1000px]:min-h-[calc(25vw-56px)] min-[1300px]:min-h-[284px]">
  <div class="flex items-center gap-3">
    <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-brand">
      <picture>
        <source type="image/webp" srcset="<%= asset_path('profile.webp') %> 1x, <%= asset_path('profile@2x.webp') %> 2x">
        <%= image_tag "profile@2x.jpeg", alt: "Json Jeong profile picture", class: "h-full w-full object-cover",
              width: 400, height: 400, loading: "eager", decoding: "async" %>
      </picture>
    </div>
    <div class="min-w-0">
      <p class="text-lg font-extrabold leading-tight tracking-tight">Json Jeong</p>
      <p class="text-xs text-muted">📍 <%= t("archive.location") %></p>
    </div>
  </div>

  <p class="mt-3 text-[13px] leading-relaxed text-ink/90"><%= t("archive.quote") %></p>

  <div class="mt-auto flex flex-wrap items-center gap-x-3 gap-y-2 pt-3">
    <nav class="inline-flex rounded-lg bg-page p-0.5 text-xs font-semibold" aria-label="Language">
      <% { ko: "한국어", en: "English" }.each do |locale, label| %>
        <%= link_to label, alternate_path(locale), hreflang: locale,
              class: "rounded-md px-2.5 py-1 #{I18n.locale == locale ? 'bg-brand text-brand-dark' : 'text-muted hover:text-ink'}",
              "aria-current": (I18n.locale == locale ? "page" : nil) %>
      <% end %>
    </nav>
    <div class="flex items-center gap-2.5 text-muted">
      <a href="https://www.threads.net/@snapplug.app" aria-label="Threads" target="_blank" rel="noopener me" class="hover:text-ink transition">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
      <path d="M17.7 11.14a8.4 8.4 0 0 0-.31-.14c-.18-3.35-2.01-5.27-5.08-5.29h-.04c-1.84 0-3.37.78-4.31 2.21l1.69 1.16c.7-1.06 1.81-1.29 2.62-1.29h.03c1.01.01 1.77.3 2.27.87.36.42.6.99.72 1.72-.93-.16-1.93-.21-3-.15-3.02.17-4.95 1.93-4.82 4.38a3.79 3.79 0 0 0 1.46 2.81c.85.66 1.94.98 3.07.92 1.49-.08 2.66-.65 3.48-1.69.62-.79.99-1.79 1.18-3.06.74.45 1.29 1.04 1.6 1.75.51 1.21.55 3.21-1.07 4.82-1.42 1.42-3.13 2.04-5.74 2.06-2.88-.02-5.07-.95-6.48-2.75C3.65 17.07 2.96 14.83 2.95 12c.01-2.83.7-5.07 2.06-6.67C6.42 3.53 8.61 2.6 11.49 2.58c2.9.02 5.13.96 6.62 2.78.74.91 1.29 2.05 1.65 3.38l1.97-.52c-.43-1.63-1.11-3.03-2.04-4.16C17.78 1.78 14.97.59 11.5.58h-.01c-3.47.02-6.24 1.22-8.24 3.59C1.47 6.27.62 8.81.6 12v.01c.02 3.19.87 5.73 2.65 7.83 2 2.36 4.77 3.57 8.24 3.59h.02c3.08-.02 5.26-.83 7.05-2.62 2.34-2.34 2.27-5.28 1.5-7.08-.55-1.3-1.6-2.36-3.04-3.06zm-5.26 5.4c-1.25.07-2.55-.49-2.62-1.71-.05-.91.65-1.92 2.7-2.04l.55-.01c.59 0 1.15.06 1.65.17-.24 2.81-1.57 3.51-2.28 3.59z"/>
    </svg>
  </a>
      <a href="https://x.com/jasonjeongio" aria-label="X" target="_blank" rel="noopener me" class="hover:text-ink transition">
    <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.674l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
    </svg>
  </a>
    </div>
    <%# 뉴스레터는 snapplug.app 한 곳(beehiiv)으로 모은다. 한국어 뉴스레터라 한국어 화면에만. %>
    <% if I18n.locale == :ko %>
      <%= link_to "뉴스레터 구독 →", SNAPPLUG_NEWSLETTER_URL, target: "_blank", rel: "noopener",
            class: "text-xs font-semibold text-brand-dark underline underline-offset-4 decoration-2 decoration-brand hover:opacity-80" %>
    <% end %>
  </div>
</section>
