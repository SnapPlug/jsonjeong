<%# 승인된 남의 실패 사례. 사진 없는 표 한 장. %>
<% if submissions.any? %>
  <section class="mt-10" aria-labelledby="others-heading">
    <h2 id="others-heading" class="text-lg font-extrabold tracking-tight"><%= t("submit.others_heading", count: submissions.size) %></h2>
    <div class="mt-3 overflow-x-auto rounded-xl bg-surface shadow-[0_0_0_1px_#ddd]">
      <table class="w-full min-w-[640px] text-sm">
        <thead class="text-left text-xs text-muted">
          <tr>
            <th class="px-3 py-2 font-semibold"><%= t("submit.f.name") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("archive.days") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("archive.hours") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("archive.cost") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("archive.revenue") %></th>
            <th class="px-3 py-2 font-semibold"><%= t("submit.f.quit_signal") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-black/10">
          <% submissions.each do |s| %>
            <tr>
              <td class="px-3 py-2 font-semibold">
                <% if s.url %><%= link_to s.name, s.url, target: "_blank", rel: "noopener nofollow ugc", class: "underline underline-offset-2" %><% else %><%= s.name %><% end %>
                <% unless s.verified? %><span class="ml-1 text-[10px] text-muted"><%= t("submit.unverified") %></span><% end %>
              </td>
              <td class="px-3 py-2 tabular-nums"><%= t("archive.days_unit", days: s.days) %></td>
              <td class="px-3 py-2 tabular-nums"><%= work_hours(s.hours) %></td>
              <td class="px-3 py-2 tabular-nums"><%= usd(s.cost_usd) %></td>
              <td class="px-3 py-2 tabular-nums"><%= usd(s.revenue_usd) %></td>
              <td class="px-3 py-2 text-ink/90"><%= s.quit_signal %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
