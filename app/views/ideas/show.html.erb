<%= render "head", title: @idea.title, description: @idea.summary %>

<main class="mx-auto max-w-2xl px-5 py-10 lg:py-16">
  <%= link_to t("archive.back"), root_path, class: "text-sm font-semibold text-muted hover:text-ink" %>

  <div class="mt-6">
    <%= render "card", idea: @idea %>
  </div>

  <article class="retro mt-10 text-[17px] leading-relaxed text-ink/90 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-ink [&_p]:mt-4">
    <%= render @idea.retro_partial %>
  </article>
</main>

<% content_for :head do %>
  <script type="application/ld+json"><%= raw retro_structured_data(@idea).to_json %></script>
<% end %>
