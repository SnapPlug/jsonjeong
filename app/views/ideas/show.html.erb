<%= render "head", title: @idea.title, description: @idea.summary %>
<% content_for :og_image, image_url("ideas/#{@idea.slug}.jpg") %>

<main class="mx-auto max-w-2xl px-4 py-8 sm:px-6 lg:py-12">
  <%= link_to t("archive.back"), root_path, class: "text-sm font-semibold text-muted hover:text-ink" %>

  <header class="relative mt-5 aspect-[16/9] overflow-hidden rounded-2xl bg-brand-dark text-white">
    <%= idea_image @idea, class: "absolute inset-0 h-full w-full object-cover" %>
    <div class="absolute inset-0 bg-gradient-to-b from-black/30 to-black/75"></div>
    <div class="absolute inset-x-0 bottom-0 p-5 [text-shadow:0_2px_8px_rgb(0_0_0/0.7)]">
      <p class="flex items-center gap-2 text-sm font-semibold"><%= render "status_badge", status: @idea.status %> <span class="opacity-90"><%= t("archive.batch_short.#{@idea.batch}") %></span></p>
      <h1 class="mt-1 text-3xl font-extrabold leading-tight"><%= @idea.title %></h1>
    </div>
  </header>

  <dl class="mt-4 grid grid-cols-3 gap-3 text-center">
    <% [ [ t("archive.hours"), work_hours(@idea.hours) ], [ t("archive.cost"), usd(@idea.cost_usd) ], [ t("archive.revenue"), usd(@idea.revenue_usd) ] ].each do |label, value| %>
      <div class="rounded-2xl bg-surface px-3 py-3">
        <dt class="text-xs text-muted"><%= label %></dt>
        <dd class="mt-0.5 font-mono text-xl font-bold text-ink"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-2 font-mono text-xs text-muted">
    <%= @idea.started_on.strftime("%Y-%m-%d") %> → <%= @idea.ongoing? ? t("archive.ongoing") : @idea.ended_on.strftime("%Y-%m-%d") %> · <%= t("archive.hours_source.#{@idea.hours_source}") %>
    <% if @idea.url %> · <a href="<%= @idea.url %>" target="_blank" rel="noopener" class="underline hover:text-ink"><%= t("archive.visit") %></a><% end %>
  </p>

  <p class="mt-6 text-[17px] font-medium leading-relaxed text-ink"><%= @idea.summary %></p>

  <% if @idea.stuck.present? || @idea.human.present? %>
    <dl class="mt-4 flex flex-col gap-2 rounded-2xl bg-surface p-4 text-[15px] leading-relaxed">
      <% if @idea.stuck.present? %><div><dt class="inline font-bold text-ink"><%= t("archive.stuck") %></dt> <dd class="inline text-ink/85"><%= @idea.stuck %></dd></div><% end %>
      <% if @idea.human.present? %><div><dt class="inline font-bold text-ink"><%= t("archive.human") %></dt> <dd class="inline text-ink/85"><%= @idea.human %></dd></div><% end %>
    </dl>
  <% end %>

  <% if @idea.retro? %>
  <article class="retro mt-6 text-[17px] leading-relaxed text-ink/90 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-bold [&_h2]:text-ink [&_p]:mt-4">
    <%= render @idea.retro_partial %>
  </article>
  <% end %>
</main>

<% content_for :head do %>
  <script type="application/ld+json"><%= raw retro_structured_data(@idea).to_json %></script>
<% end %>
