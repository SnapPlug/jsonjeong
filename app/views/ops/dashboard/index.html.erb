<% content_for :title, "홈" %>

<div>
  <h1 class="text-lg font-semibold text-zinc-100">대시보드</h1>
  <p class="mt-0.5 text-xs text-zinc-500">계약현황과 서비스 상태</p>
</div>

<section class="grid grid-cols-2 gap-3 md:grid-cols-4">
  <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
    <p class="text-xs text-zinc-500">진행 중 계약</p>
    <p class="mt-1.5 text-2xl font-semibold text-zinc-100"><%= @open_contracts %></p>
  </div>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
    <p class="text-xs text-zinc-500">미수금</p>
    <p class="mt-1.5 text-2xl font-semibold <%= @unpaid.any?(&:overdue?) ? "text-red-400" : "text-yellow-400" %>"><%= won(@unpaid_total) %></p>
  </div>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
    <p class="text-xs text-zinc-500">이번 달 수금</p>
    <p class="mt-1.5 text-2xl font-semibold text-zinc-100"><%= won(@paid_this_month) %></p>
  </div>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
    <p class="text-xs text-zinc-500">비정상 서비스</p>
    <p class="mt-1.5 text-2xl font-semibold <%= @unhealthy > 0 ? "text-red-400" : "text-green-400" %>"><%= @unhealthy %></p>
  </div>
</section>

<section class="space-y-2">
  <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">미수금</h2>
  <% if @unpaid.empty? %>
    <p class="rounded-lg border border-zinc-800 bg-zinc-900 p-6 text-center text-zinc-500">미수금이 없습니다</p>
  <% else %>
    <div class="divide-y divide-zinc-800 rounded-lg border border-zinc-800 bg-zinc-900">
      <% @unpaid.each do |payment| %>
        <div class="flex flex-wrap items-center gap-3 px-4 py-2.5 hover:bg-zinc-800/40">
          <%= link_to payment.contract.client.name, ops_client_path(payment.contract.client), class: "font-medium text-zinc-100 hover:underline" %>
          <span class="truncate text-zinc-500"><%= payment.contract.name %> · <%= OpsHelper::PAYMENT_KINDS[payment.kind] %></span>
          <span class="flex-1"></span>
          <span class="font-semibold text-zinc-100"><%= won(payment.amount) %></span>
          <span class="text-xs text-zinc-500">마감 <%= payment.due_on %></span>
          <% if days_overdue(payment.due_on) > 0 %>
            <span class="text-xs font-medium text-red-400">+<%= days_overdue(payment.due_on) %>일</span>
          <% end %>
          <%= status_form ops_payment_path(payment), "payment[status]", payment.status, OpsHelper::PAYMENT_STATUSES %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section class="space-y-2">
  <div class="flex items-center justify-between">
    <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">서비스 상태</h2>
    <%= button_to "지금 체크", ops_health_check_path, class: OpsHelper::SECONDARY_BUTTON %>
  </div>
  <% if @services.empty? %>
    <p class="rounded-lg border border-zinc-800 bg-zinc-900 p-6 text-center text-zinc-500">감시 중인 서비스가 없습니다. 고객사 상세에서 서비스 정보를 넣으세요.</p>
  <% else %>
    <div class="divide-y divide-zinc-800 rounded-lg border border-zinc-800 bg-zinc-900">
      <% @services.each do |client| %>
        <% logs = @latest[client.id] || {} %>
        <div class="flex flex-wrap items-center gap-2 px-4 py-2.5 hover:bg-zinc-800/40">
          <%= link_to client.name, ops_client_path(client), class: "w-44 truncate font-medium text-zinc-100 hover:underline" %>
          <% client.checks.each do |check| %>
            <% log = logs[check] %>
            <span class="inline-flex items-center gap-1.5 rounded border px-1.5 py-0.5 text-xs <%= log.nil? ? OpsHelper::GRAY : (log.ok ? OpsHelper::GREEN : OpsHelper::RED) %>">
              <span class="h-1.5 w-1.5 rounded-full <%= ok_dot(log&.ok) %>"></span>
              <%= HealthLog::LABELS[check] %>
              <% if log&.ms %><span class="text-zinc-500"><%= log.ms %>ms</span><% end %>
            </span>
            <% if log && !log.ok %>
              <span class="max-w-xs truncate text-xs text-red-400" title="<%= log.error %>"><%= log.error %></span>
            <% end %>
          <% end %>
          <span class="flex-1"></span>
          <span class="text-xs text-zinc-600"><%= logs.values.map(&:checked_at).max&.then { |t| kst(t) } || "아직 체크 전" %></span>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section class="space-y-2">
  <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">월 수금 · 최근 12개월 · 마감일 기준</h2>
  <% peak = [ @monthly.values.max.to_i, 1 ].max %>
  <div class="rounded-lg border border-zinc-800 bg-zinc-900 p-4">
    <div class="flex h-40 items-end gap-2">
      <% @months.each do |month| %>
        <% amount = @monthly[month].to_i %>
        <div class="flex h-full flex-1 flex-col items-center justify-end gap-1" title="<%= month %> <%= won(amount) %>">
          <span class="text-[10px] text-zinc-500"><%= amount > 0 ? "#{amount / 10_000}만" : "" %></span>
          <div class="w-full rounded-t bg-indigo-500/70 hover:bg-indigo-400" style="height: <%= (amount * 100.0 / peak).round %>%"></div>
          <span class="text-[10px] text-zinc-600"><%= month[5..] %>월</span>
        </div>
      <% end %>
    </div>
  </div>
</section>
