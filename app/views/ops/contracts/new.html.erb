<% content_for :title, "새 계약" %>
<% input = OpsHelper::INPUT %>

<h1 class="text-lg font-semibold text-zinc-100">새 계약</h1>

<% if @errors %>
  <ul class="rounded-md border border-red-500/20 bg-red-500/10 px-3 py-2 text-red-400">
    <% @errors.each do |message| %><li><%= message %></li><% end %>
  </ul>
<% end %>

<%= form_with url: ops_contracts_path, class: "max-w-2xl space-y-5 rounded-lg border border-zinc-800 bg-zinc-900 p-5" do %>
  <label class="block space-y-1.5">
    <span class="text-xs text-zinc-500">고객사 <span class="text-zinc-600">— 있는 이름이면 재계약, 새 이름이면 함께 등록</span></span>
    <%= text_field_tag :client_name, @client_name, list: "client-names", required: true, autofocus: @client_name.blank?, autocomplete: "off", class: input %>
    <datalist id="client-names">
      <% @client_names.each do |name| %><option value="<%= name %>"></option><% end %>
    </datalist>
  </label>

  <label class="block space-y-1.5">
    <span class="text-xs text-zinc-500">계약명</span>
    <%= text_field_tag "contract[name]", @contract.name, required: true, placeholder: "예: AI 고객 상담 에이전트 구축", class: input %>
  </label>

  <div class="grid grid-cols-3 gap-3">
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">금액(원)</span><%= number_field_tag "contract[amount]", @contract.amount, min: 1, required: true, class: input %></label>
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">시작일</span><%= date_field_tag "contract[starts_on]", @contract.starts_on, required: true, class: input %></label>
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">종료일</span><%= date_field_tag "contract[ends_on]", @contract.ends_on, required: true, class: input %></label>
  </div>

  <fieldset class="space-y-1.5">
    <legend class="mb-1 text-xs text-zinc-500">납부 일정</legend>
    <label class="flex items-center gap-2 text-zinc-300"><%= radio_button_tag :schedule, "half", @schedule == "half", class: "accent-zinc-400" %> 계약금 50% (시작일) · 잔금 50% (종료일)</label>
    <label class="flex items-center gap-2 text-zinc-300"><%= radio_button_tag :schedule, "thirds", @schedule == "thirds", class: "accent-zinc-400" %> 계약금 30% · 중도금 40% (중간) · 잔금 30%</label>
    <label class="flex items-center gap-2 text-zinc-300"><%= radio_button_tag :schedule, "none", @schedule == "none", class: "accent-zinc-400" %> 납부 일정 없이</label>
    <label class="flex items-center gap-2 text-zinc-300"><%= radio_button_tag :schedule, "manual", @schedule == "manual", class: "accent-zinc-400" %> 직접 입력</label>
    <div class="ml-6 mt-1 grid grid-cols-[4rem_1fr_1fr] items-center gap-2 text-xs">
      <% OpsHelper::PAYMENT_KINDS.each_with_index do |(kind, label), i| %>
        <span class="text-zinc-500"><%= label %></span>
        <%= hidden_field_tag "contract[payments_attributes][#{i}][kind]", kind %>
        <%= number_field_tag "contract[payments_attributes][#{i}][amount]", nil, min: 0, placeholder: "금액", class: input %>
        <%= date_field_tag "contract[payments_attributes][#{i}][due_on]", nil, class: input %>
      <% end %>
    </div>
  </fieldset>

  <details class="text-xs text-zinc-500">
    <summary class="cursor-pointer hover:text-zinc-300">사업자등록번호 · 메모</summary>
    <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2">
      <label class="block space-y-1.5"><span>사업자등록번호</span><%= text_field_tag "contract[business_number]", @contract.business_number, placeholder: "000-00-00000", class: input %></label>
      <label class="block space-y-1.5"><span>메모</span><%= text_field_tag "contract[notes]", @contract.notes, class: input %></label>
    </div>
  </details>

  <%= submit_tag "계약 등록", class: OpsHelper::PRIMARY_BUTTON %>
<% end %>
