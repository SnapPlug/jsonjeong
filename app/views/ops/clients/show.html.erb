<% content_for :title, @client.name %>

<div class="flex flex-wrap items-center gap-3">
  <h1 class="text-lg font-semibold text-zinc-100"><%= @client.name %></h1>
  <%= status_badge @client.status, OpsHelper::CLIENT_STATUSES %>
  <span class="text-xs text-zinc-500"><%= OpsHelper::CLIENT_KINDS[@client.kind] %></span>
  <span class="flex-1"></span>
  <%= link_to "이 고객사에 새 계약", new_ops_contract_path(client_name: @client.name), class: OpsHelper::SECONDARY_BUTTON %>
</div>

<section class="space-y-2">
  <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">계약</h2>
  <div class="divide-y divide-zinc-800 rounded-lg border border-zinc-800 bg-zinc-900">
    <% @contracts.each do |contract| %>
      <div class="flex flex-wrap items-center gap-3 px-4 py-2.5 hover:bg-zinc-800/40">
        <div class="min-w-0 flex-1">
          <p class="font-medium text-zinc-100"><%= contract.name %></p>
          <p class="text-xs text-zinc-500">
            <%= contract.starts_on %> ~ <%= contract.ends_on %>
            <% if contract.business_number %> · <%= contract.business_number %><% end %>
            <% if contract.notes %> · <%= contract.notes %><% end %>
          </p>
        </div>
        <span class="font-semibold text-zinc-100"><%= won(contract.amount) %></span>
        <%= status_form ops_contract_path(contract), "contract[status]", contract.status, OpsHelper::CONTRACT_STATUSES %>
      </div>
    <% end %>
    <% if @contracts.empty? %><p class="p-6 text-center text-zinc-500">계약이 없습니다</p><% end %>
  </div>
</section>

<section class="space-y-2">
  <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">납부</h2>
  <div class="divide-y divide-zinc-800 rounded-lg border border-zinc-800 bg-zinc-900">
    <% @payments.each do |payment| %>
      <div class="flex flex-wrap items-center gap-3 px-4 py-2.5 hover:bg-zinc-800/40">
        <span class="min-w-0 flex-1 truncate text-zinc-200"><%= payment.contract.name %> · <%= OpsHelper::PAYMENT_KINDS[payment.kind] %></span>
        <span class="font-semibold text-zinc-100"><%= won(payment.amount) %></span>
        <span class="text-xs text-zinc-500">마감 <%= payment.due_on %><% if payment.paid_on %> · 수금 <%= payment.paid_on %><% end %></span>
        <%= status_form ops_payment_path(payment), "payment[status]", payment.status, OpsHelper::PAYMENT_STATUSES %>
      </div>
    <% end %>
    <% if @payments.empty? %><p class="p-6 text-center text-zinc-500">납부 일정이 없습니다</p><% end %>
  </div>
</section>

<section class="space-y-2">
  <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">서비스 정보 · 고객사 설정</h2>
  <%= form_with model: @client, url: ops_client_path(@client), class: "grid grid-cols-1 gap-4 rounded-lg border border-zinc-800 bg-zinc-900 p-4 md:grid-cols-2" do |f| %>
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">고객사명</span><%= f.text_field :name, class: OpsHelper::INPUT %></label>
    <div class="grid grid-cols-2 gap-3">
      <label class="block space-y-1.5"><span class="text-xs text-zinc-500">종류</span><%= f.select :kind, OpsHelper::CLIENT_KINDS.map { |k, v| [ v, k ] }, {}, class: OpsHelper::INPUT + " cursor-pointer" %></label>
      <label class="block space-y-1.5"><span class="text-xs text-zinc-500">상태</span><%= f.select :status, OpsHelper::CLIENT_STATUSES.map { |k, v| [ v, k ] }, {}, class: OpsHelper::INPUT + " cursor-pointer" %></label>
    </div>
    <label class="block space-y-1.5 md:col-span-2"><span class="text-xs text-zinc-500">헬스체크 URL <span class="text-zinc-600">— Rails는 /health. 2xx면 정상, JSON의 failed[]는 알림에 실림</span></span>
      <%= f.url_field :health_url, placeholder: "https://example.com/health", class: OpsHelper::INPUT %></label>
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">Vercel 프로젝트 ID</span><%= f.text_field :vercel_project_id, placeholder: "prj_...", class: OpsHelper::INPUT %></label>
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">Vercel 팀 ID <span class="text-zinc-600">— 고객사 계정이면</span></span><%= f.text_field :vercel_team_id, placeholder: "team_...", class: OpsHelper::INPUT %></label>
    <label class="block space-y-1.5"><span class="text-xs text-zinc-500">Supabase 프로젝트 ref</span><%= f.text_field :supabase_ref, class: OpsHelper::INPUT %></label>
    <label class="block space-y-1.5 md:col-span-2"><span class="text-xs text-zinc-500">메모</span><%= f.text_area :notes, rows: 2, class: OpsHelper::INPUT %></label>
    <div class="md:col-span-2"><%= f.submit "저장", class: OpsHelper::PRIMARY_BUTTON %></div>
  <% end %>
</section>

<% if @logs.any? %>
  <section class="space-y-2">
    <h2 class="text-xs font-medium uppercase tracking-wide text-zinc-500">최근 체크</h2>
    <div class="divide-y divide-zinc-800 rounded-lg border border-zinc-800 bg-zinc-900 text-xs">
      <% @logs.each do |log| %>
        <div class="flex items-center gap-3 px-4 py-1.5">
          <span class="h-1.5 w-1.5 rounded-full <%= ok_dot(log.ok) %>"></span>
          <span class="w-24 text-zinc-300"><%= HealthLog::LABELS[log.check_type] %></span>
          <span class="w-16 text-zinc-500"><%= log.ms ? "#{log.ms}ms" : "" %></span>
          <span class="flex-1 truncate text-red-400"><%= log.error %></span>
          <span class="text-zinc-600"><%= kst(log.checked_at) %></span>
        </div>
      <% end %>
    </div>
  </section>
<% end %>
