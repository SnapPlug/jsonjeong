<!DOCTYPE html>
<html lang="ko">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Overload" %> · ops</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <link rel="icon" href="/icon.png?v=3" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-page text-ink antialiased min-h-screen">
    <header class="bg-brand-dark text-white">
      <div class="mx-auto flex h-12 max-w-5xl items-center gap-5 px-4 text-sm">
        <%= link_to "Overload", ops_root_path, class: "font-semibold" %>
        <%= link_to "새 계약", new_ops_contract_path, class: "text-white/80 hover:text-white" %>
        <span class="flex-1"></span>
        <%= button_to "로그아웃", session_path, method: :delete, class: "text-white/60 hover:text-white cursor-pointer" %>
      </div>
    </header>

    <main class="mx-auto max-w-5xl space-y-8 px-4 py-6">
      <% if notice %>
        <p class="rounded-lg bg-green-50 px-3 py-2 text-sm text-green-700"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="rounded-lg bg-red-50 px-3 py-2 text-sm text-red-700"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
